
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consultas | Agenda Médica</title>

    <link rel="stylesheet" href="/css/consultas.css">

    <style>
        body {
            margin: 0;
            padding: 30px;
            background: #F4F6F9;
            color: #1A1A1A;
            font-family: 'Quattrocento Sans', sans-serif;
        }

        h1 {
            color: #145C4B;
            font-family: 'Fraunces', serif;
        }

        .encabezado {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .botones button, .boton-nueva {
            padding: 10px 18px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            background: #CDE8DF;
            color: #145C4B;
            font-weight: bold;
            text-decoration: none;
        }

        .boton-nueva {
            background: #145C4B;
            color: white;
        }

        .filtros {
            display: flex;
            gap: 15px;
            align-items: end;
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .filtros label {
            display: block;
            margin-bottom: 7px;
        }

        .filtros input, .filtros select {
            padding: 9px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .tabla-contenedor {
            background: white;
            padding: 20px;
            border-radius: 10px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 14px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        th {
            color: #145C4B;
        }

        .badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 13px;
            font-weight: bold;
        }

        .confirmada {
            background: #CDE8DF;
            color: #145C4B;
        }

        .pendiente {
            background: #FFF0C2;
            color: #8A6500;
        }

        .cancelada {
            background: #FADADA;
            color: #A52A2A;
        }

        .total {
            text-align: right;
            font-weight: bold;
            color: #145C4B;
            background: #CDE8DF;
        }

        .sin-resultados {
            text-align: center;
            padding: 25px;
            color: #777;
        }

        .mensaje-error {
            color: #A52A2A;
            background: #FADADA;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 15px;
        }

        @media (max-width: 700px) {
            .encabezado, .filtros {
                flex-direction: column;
                align-items: stretch;
            }
        }
        
        #panelFormulario {
            display: none;
        }
    </style>
</head>

<body>

    <header class="encabezado">
        <div>
            <h1>Agenda Médica</h1>
            <p>Administración de consultas</p>
        </div>

        <button type="button" class="boton-nueva" onclick="abrirFormulario()">
            + Nueva consulta
        </button>
    </header>

    <main>

        <div class="botones">
            <button type="button" onclick="mostrarLista()">
                Lista
            </button>

            <button type="button" onclick="mostrarCalendario()">
                Calendario
            </button>
        </div>

        <br>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mensaje-error">
                <%= error %>
            </div>
        <% } %>

        <form action="/consultas" method="GET" class="filtros">

            <div>
                <label for="fecha">Fecha:</label>
                <input
                    type="date"
                    id="fecha"
                    name="fecha"
                    value="<%= fecha %>"
                >
            </div>

            <div>
                <label for="estatus">Estatus:</label>

                <select name="estatus" id="estatus">
                    <option value="">Todos</option>

                    <option value="confirmada"
                        <%= estatus === 'confirmada' ? 'selected' : '' %>>
                        Confirmada
                    </option>

                    <option value="pendiente"
                        <%= estatus === 'pendiente' ? 'selected' : '' %>>
                        Pendiente
                    </option>

                    <option value="cancelada"
                        <%= estatus === 'cancelada' ? 'selected' : '' %>>
                        Cancelada
                    </option>
                </select>
            </div>

            <button type="submit" class="boton-nueva">
                Filtrar
            </button>

            <a href="/consultas">Limpiar filtros</a>

        </form>

        <section id="lista" class="tabla-contenedor">

            <h2>Consultas registradas</h2>

            <table>
                <thead>
                    <tr>
                        <th>Hora</th>
                        <th>Paciente</th>
                        <th>Doctor</th>
                        <th>Costo</th>
                        <th>Estatus</th>
                    </tr>
                </thead>

                <tbody>

                    <% if (consultas.length > 0) { %>

                        <% consultas.forEach(consulta => { %>

                            <tr>
                                <td>
                                    <%= String(consulta.hora).slice(0, 5) %>
                                </td>

                                <td>
                                    <%= consulta.paciente_nombre %>
                                </td>

                                <td>
                                    <%= consulta.doctor %>
                                </td>

                                <td>
                                    $<%= Number(consulta.costo).toFixed(2) %>
                                </td>

                                <td>
                                    <span class="badge <%= consulta.estatus %>">
                                        <%= consulta.estatus.charAt(0).toUpperCase() + consulta.estatus.slice(1) %>
                                    </span>
                                </td>
                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>
                            <td colspan="5" class="sin-resultados">
                                No hay consultas registradas.
                            </td>
                        </tr>

                    <% } %>

                </tbody>

                <tfoot>
                    <tr>
                        <td colspan="3" class="total">
                            Total de consultas confirmadas del día:
                        </td>

                        <td colspan="2" class="total">
                            $<%= Number(totalConfirmadas).toFixed(2) %>
                        </td>
                    </tr>
                </tfoot>

            </table>

        </section>

        <section id="calendario" style="display: none;">
            <h2>Calendario mensual</h2>
            <p>El calendario estará disponible en la siguiente etapa.</p>
        </section>

        <%- include('_formulario') %>
    </main>

    <script>
        // Mostrar la lista
        function mostrarLista() {
            document.getElementById('lista').style.display = 'block';
            document.getElementById('calendario').style.display = 'none';
        }

        // Mostrar el calendario
        function mostrarCalendario() {
            window.location.href = '/consultas/calendario';
        }
    </script>

</body>
</html>